{
  "name": "frizz",
  "version": "0.13.19",
  "private": false,
  "description": "A local web UI for running many coding agents at once",
  "keywords": [
    "frizz",
    "agents",
    "claude-code",
    "codex",
    "orchestration",
    "dashboard",
    "ai"
  ],
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://github.com/colinhacks/frizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/frizz.git"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "type": "module",
  "bin": {
    "frizz": "./dist/frizz.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nub packages/server/src/dev.ts",
    "frizz-dev:install": "nub scripts/install-global-cli.mjs",
    "frizz-dev:check": "nub scripts/install-global-cli.mjs --check",
    "frizz-dev:uninstall": "nub scripts/install-global-cli.mjs --uninstall",
    "install:global": "nub scripts/install-global-cli.mjs",
    "typecheck": "tsc -b packages/shared packages/rpc packages/claude-agent-sdk-runtime packages/server packages/registrar packages/relay . packages/web packages/web/tsconfig.test.json",
    "typecheck:artifact": "tsc -b packages/shared packages/rpc packages/claude-agent-sdk-runtime packages/server packages/registrar packages/relay . packages/web",
    "test": "nub scripts/run-tests.mjs",
    "test:e2e": "nub scripts/e2e-web.mjs",
    "prepack": "node ./scripts/prepare-package.mjs --server && node ./scripts/build-package.mjs --server && node ./scripts/build-package.mjs --shell && node ./scripts/publish-manifest.mjs --strip",
    "postpack": "node ./scripts/publish-manifest.mjs --restore"
  },
  "devDependencies": {
    "@frizz/server": "workspace:*",
    "@frizz/shared": "workspace:*",
    "@types/node": "^24",
    "@types/ws": "^8.5",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "node-pty": "1.2.0-beta.15",
    "puppeteer": "^25.3.0",
    "typescript": "^5.7",
    "ws": "^8.18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "frizzServer": {
    "package": "frizz-server",
    "version": "0.15.51",
    "minimum": "0.15.48",
    "protocol": 1,
    "dataEpoch": 1
  }
}

{
  "name": "frizz",
  "version": "0.12.4",
  "private": false,
  "description": "A local web UI for running many coding agents at once",
  "keywords": [
    "frizz",
    "agents",
    "claude-code",
    "codex",
    "orchestration",
    "dashboard",
    "ai"
  ],
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://github.com/colinhacks/frizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/frizz.git"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "type": "module",
  "bin": {
    "frizz": "./dist/frizz.js"
  },
  "files": [
    "dist",
    "web-dist",
    "runtime"
  ],
  "scripts": {
    "dev": "nub packages/server/src/dev.ts",
    "frizz-dev:install": "nub scripts/install-global-cli.mjs",
    "frizz-dev:check": "nub scripts/install-global-cli.mjs --check",
    "frizz-dev:uninstall": "nub scripts/install-global-cli.mjs --uninstall",
    "install:global": "nub scripts/install-global-cli.mjs",
    "typecheck": "tsc -b packages/shared packages/rpc packages/server packages/registrar packages/relay . packages/web",
    "test": "nub scripts/run-tests.mjs",
    "test:e2e": "nub scripts/e2e-web.mjs",
    "prepack": "node ./scripts/prepare-package.mjs && node ./scripts/build-package.mjs && node ./scripts/publish-manifest.mjs --strip",
    "postpack": "node ./scripts/publish-manifest.mjs --restore && node ./scripts/prepare-package.mjs --clean"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5",
    "node-pty": "^1.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@frizz/server": "workspace:*",
    "@frizz/shared": "workspace:*",
    "@types/node": "^24",
    "@types/ws": "^8.5",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "puppeteer": "^25.3.0",
    "typescript": "^5.7",
    "ws": "^8.18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "node-pty",
      "@parcel/watcher",
      "esbuild",
      "@frizz/server"
    ]
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src"],
  // *.test.ts are node:test files, not part of the browser bundle, and this config has no node
  // types. tsconfig.test.json checks them, with node's types beside the DOM's.
  "exclude": ["src/**/*.test.ts"]
}
